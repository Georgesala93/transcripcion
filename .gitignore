# Archivos binarios de audio y video (incluye subcarpetas de temas)
media/mp3/**
media/video/**

# Pero permitir .gitkeep para mantener carpetas vacías
!media/mp3/.gitkeep
!media/video/.gitkeep
!media/text/.gitkeep

# Archivos generados (texto de transcripciones por carpeta)
media/text/**/ *_transcripcion.txt
media/text/**/ *_extracted.mp3

# Configuración local
.env
.env.local
